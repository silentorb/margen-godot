[configuration]

entry_symbol = "margen_godot_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://bin/libmargen_godot.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libmargen_godot.linux.template_release.x86_64.so"

[dependencies]

linux.debug.x86_64 = {
  "res://bin/libmargen_ffi.so": ""
}
linux.release.x86_64 = {
  "res://bin/libmargen_ffi.so": ""
}
